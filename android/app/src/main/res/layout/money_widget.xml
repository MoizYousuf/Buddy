<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/money_widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠 Ghar se lene hain" android:textColor="#CCFFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/owes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PKR 0" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👛 Pocket" android:textColor="#CCFFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/wallet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PKR 0" android:textColor="#C6F432" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
